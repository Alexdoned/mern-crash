{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "backend/**/*",
    "backend/config/**/*",
    "frontend/**/*",
    "*.js"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "dist",
    "build"
  ]
}
